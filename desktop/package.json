{
  "name": "tunisiaflicks-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "TunisiaFlicks desktop app — runs the ad-free local torrent-streaming player on the viewer's own machine.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "app.tunisiaflicks.desktop",
    "productName": "TunisiaFlicks",
    "files": ["main.js", "preload.js", "app/**/*"],
    "extraResources": [
      { "from": "../player-service", "to": "player-service", "filter": ["**/*", "!**/*.log", "!**/*.bin", "!add*.json", "!test-codec.mjs"] }
    ],
    "asar": true,
    "win": { "target": ["nsis"], "artifactName": "TunisiaFlicks-Setup-${version}.${ext}" },
    "mac": { "target": ["dmg"] },
    "linux": { "target": ["AppImage"] },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true }
  }
}
